{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Saturn",
  "version": "0.1.0",
  "identifier": "com.zvirox.ProjectSaturn",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Saturn",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/icons/saturn-camera.png"]
  }
}
